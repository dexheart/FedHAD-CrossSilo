# Saídas do CodeCarbon
emissions.csv
.codecarbon.config
.emissions/

# Logs do coordenador de experimentos (nome com timestamp)
run_experiments_log*.csv
# Arquivo de progresso da retomada (execuções já concluídas)
run_experiments_progress.jsonl

# Saídas do parser de consolidação (analisar_resultados.py) — derivadas dos resultados,
# regeneráveis. Remova estas linhas se quiser versionar as tabelas consolidadas no git.
analise_bruta.csv
analise_resumo.csv

# Execuções corrompidas/crashadas isoladas por limpar_corrompidos.py — não fazem parte
# da análise, apenas um backup local antes da remoção.
backups_corrompidos/

# ==========================================================================
# Dados baixados pelo PyTorch/torchvision
# ==========================================================================
data/

